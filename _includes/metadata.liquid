{% assign seo_site_name = site.title | default: 'CAE ML Datasets' | strip %}
{% assign seo_organization_name = site.data.seo.organization.name | default: seo_site_name | strip %}
{% assign seo_page_path = page.url | default: '/' | replace: 'index.html', '' %}
{% if seo_page_path == blank %}
  {% assign seo_page_path = '/' %}
{% endif %}
{% assign metadata_dataset = null %}
{% if page.dataset_key %}
  {% assign metadata_dataset = site.data.datasets | where: 'key', page.dataset_key | first %}
{% endif %}

{% assign seo_page_name = page.seo_title | default: page.page_title | default: page.title | default: seo_site_name %}
{% if metadata_dataset and page.seo_title == blank %}
  {% assign seo_page_name = metadata_dataset.seo_title %}
{% endif %}
{% assign seo_page_name = seo_page_name | strip_html | strip_newlines | strip %}
{% if seo_page_name == 'blank' %}
  {% assign seo_page_name = seo_site_name %}
{% endif %}
{% if seo_page_name == seo_site_name %}
  {% assign seo_title = seo_site_name %}
{% else %}
  {% capture seo_title %}{{ seo_page_name }} | {{ seo_site_name }}{% endcapture %}
  {% assign seo_title = seo_title | strip %}
{% endif %}

{% assign seo_description = page.description | default: metadata_dataset.description | default: site.description | default: seo_page_name %}
{% assign seo_description = seo_description | strip_html | strip_newlines | strip %}

{% if page.canonical_url %}
  {% if page.canonical_url contains '://' %}
    {% assign seo_canonical_url = page.canonical_url %}
  {% else %}
    {% assign seo_canonical_url = page.canonical_url | absolute_url %}
  {% endif %}
{% else %}
  {% assign seo_canonical_url = seo_page_path | absolute_url %}
{% endif %}
{% assign seo_canonical_url = seo_canonical_url | replace: '/index.html', '/' %}
{% assign seo_site_url = '/' | absolute_url %}

{% assign seo_image = page.og_image | default: site.og_image | default: site.data.seo.default_image %}
{% assign seo_image_url = '' %}
{% assign seo_image_width = page.og_image_width | default: site.og_image_width | default: site.data.seo.default_image_width %}
{% assign seo_image_height = page.og_image_height | default: site.og_image_height | default: site.data.seo.default_image_height %}
{% assign seo_image_type = page.og_image_type | default: site.og_image_type | default: site.data.seo.default_image_type %}
{% if seo_image != blank %}
  {% if seo_image contains '://' %}
    {% assign seo_image_url = seo_image %}
  {% else %}
    {% assign seo_image_url = seo_image | absolute_url %}
  {% endif %}
{% endif %}

{% assign seo_robots = 'index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1' %}
{% if page.robots %}
  {% assign seo_robots = page.robots %}
{% elsif page.noindex or page.sitemap == false or seo_page_path == '/404.html' or page.redirect %}
  {% assign seo_robots = 'noindex, follow' %}
{% endif %}

{% if site.enable_google_verification and site.google_site_verification != blank %}
  <meta name="google-site-verification" content="{{ site.google_site_verification | escape }}">
{% endif %}
{% if site.enable_bing_verification and site.bing_site_verification != blank %}
  <meta name="msvalidate.01" content="{{ site.bing_site_verification | escape }}">
{% endif %}

<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1, shrink-to-fit=no">
<meta http-equiv="X-UA-Compatible" content="IE=edge">
<title>{{ seo_title | escape }}</title>
<meta name="author" content="{{ seo_organization_name | escape }}">
<meta name="description" content="{{ seo_description | escape }}">
<meta name="robots" content="{{ seo_robots | escape }}">
<link rel="canonical" href="{{ seo_canonical_url | escape }}">

{% if site.serve_og_meta %}
  <meta property="og:site_name" content="{{ seo_site_name | escape }}">
  <meta property="og:type" content="website">
  <meta property="og:title" content="{{ seo_title | escape }}">
  <meta property="og:url" content="{{ seo_canonical_url | escape }}">
  <meta property="og:description" content="{{ seo_description | escape }}">
  <meta property="og:locale" content="{{ site.lang | default: 'en' | replace: '-', '_' | escape }}">
  {% if seo_image_url != blank %}
    <meta property="og:image" content="{{ seo_image_url | escape }}">
    <meta property="og:image:secure_url" content="{{ seo_image_url | escape }}">
    <meta property="og:image:alt" content="CAE ML Datasets — high-fidelity CFD data for machine learning">
    <meta property="og:image:width" content="{{ seo_image_width }}">
    <meta property="og:image:height" content="{{ seo_image_height }}">
    <meta property="og:image:type" content="{{ seo_image_type | escape }}">
  {% endif %}
  <meta name="twitter:card" content="summary_large_image">
  <meta name="twitter:title" content="{{ seo_title | escape }}">
  <meta name="twitter:description" content="{{ seo_description | escape }}">
  {% if seo_image_url != blank %}
    <meta name="twitter:image" content="{{ seo_image_url | escape }}">
    <meta name="twitter:image:alt" content="CAE ML Datasets — high-fidelity CFD data for machine learning">
  {% endif %}
{% endif %}

{% if site.serve_schema_org %}
  {% include structured_data.liquid %}
{% endif %}
