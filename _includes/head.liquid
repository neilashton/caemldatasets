{% include metadata.liquid %}

<meta name="theme-color" content="#071923">
<link rel="stylesheet" href="{{ '/assets/css/bootstrap.min.css' | relative_url | bust_file_cache }}">

{% assign load_code_styles = false %}
{% if page.code or page.layout == 'dataset' or page.layout == 'post' %}
  {% assign load_code_styles = true %}
{% endif %}
{% if load_code_styles %}
  <link rel="stylesheet" href="{{ '/assets/css/jekyll-pygments-themes-github.css' | relative_url | bust_file_cache }}" id="highlight_theme_light">
{% endif %}

{% if page.toc and page.toc.sidebar %}
  <link href="{{ '/assets/css/bootstrap-toc.min.css' | relative_url | bust_file_cache }}" rel="stylesheet">
{% endif %}

{% if site.icon != blank %}
  <link rel="icon" type="image/png" href="{{ site.icon | prepend: '/assets/img/' | relative_url | bust_file_cache }}">
  <link rel="icon" href="{{ '/favicon.ico' | relative_url }}" sizes="any">
{% endif %}
<link rel="stylesheet" href="{{ '/assets/css/main.css' | relative_url | bust_css_cache }}">

<script src="{{ '/assets/js/theme.js' | relative_url | bust_file_cache }}"></script>
{% if site.enable_darkmode %}
  {% if load_code_styles %}
    <link
      rel="stylesheet"
      href="{{ '/assets/css/jekyll-pygments-themes-native.css' | relative_url | bust_file_cache }}"
      media="none"
      id="highlight_theme_dark"
    >
  {% endif %}
  <script>
    initTheme();
  </script>
{% endif %}
