<footer class="site-footer" role="contentinfo">
  <div class="container site-footer__grid">
    <div class="site-footer__brand">
      <a href="{{ '/' | relative_url }}">CAE ML Datasets</a>
      <p>{{ site.footer_text }}</p>
    </div>
    <nav class="site-footer__nav" aria-label="Footer navigation">
      <a href="{{ '/datasets/' | relative_url }}">Datasets</a>
      <a href="{{ '/getting-started/' | relative_url }}">Data access</a>
      <a href="{{ '/publications/' | relative_url }}">Publications</a>
      <a href="{{ '/news/' | relative_url }}">Updates</a>
    </nav>
    <div class="site-footer__contact">
      <span>Corrections and enquiries</span>
      <a href="mailto:{{ site.email }}">{{ site.email }}</a>
    </div>
  </div>
  <div class="container site-footer__meta">
    <span>&copy; {{ site.time | date: '%Y' }} CAE ML Datasets.</span>
    <span>Dataset licences are listed on each dataset page.</span>
    {% if site.last_updated -%}
      <span>Site updated {{ 'now' | date: '%-d %B %Y' }}.</span>
    {%- endif %}
  </div>
</footer>
