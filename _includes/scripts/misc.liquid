{% if site.enable_tooltips %}
  <script>
    $(function () {
      $('[data-toggle="tooltip"]').tooltip();
    });
  </script>
{% endif %}
{% if site.enable_medium_zoom and page.zoomable_images %}
  <script defer src="{{ site.third_party_libraries.medium_zoom.url.js }}"></script>
  <script defer src="{{ '/assets/js/zoom.js' | relative_url | bust_file_cache }}"></script>
{% endif %}
{% if page.toc and page.toc.sidebar %}
  <script defer src="{{ '/assets/js/bootstrap-toc.min.js' | relative_url | bust_file_cache }}"></script>
{% endif %}
<script src="{{ '/assets/js/no_defer.js' | relative_url | bust_file_cache }}"></script>
<script defer src="{{ '/assets/js/common.js' | relative_url | bust_file_cache }}"></script>
{% if page.code or page.layout == 'post' %}
  <script defer src="{{ '/assets/js/copy_code.js' | relative_url | bust_file_cache }}"></script>
{% endif %}
{% if page.catalog_js %}
  <script defer src="{{ '/assets/js/dataset-catalog.js' | relative_url | bust_file_cache }}"></script>
{% endif %}
