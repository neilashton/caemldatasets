<header class="site-header">
  <nav id="navbar" class="navbar navbar-expand-md" aria-label="Primary navigation">
    <div class="container">
      <a class="site-brand" href="{{ '/' | relative_url }}" aria-label="CAE ML Datasets home">
        <span class="site-brand__mark" aria-hidden="true">CAE</span>
        <span class="site-brand__name">ML Datasets</span>
      </a>

      <button
        class="navbar-toggler collapsed ml-auto"
        type="button"
        data-toggle="collapse"
        data-target="#navbarNav"
        aria-controls="navbarNav"
        aria-expanded="false"
        aria-label="Toggle navigation"
      >
        <span class="icon-bar top-bar"></span>
        <span class="icon-bar middle-bar"></span>
        <span class="icon-bar bottom-bar"></span>
      </button>

      <div class="collapse navbar-collapse" id="navbarNav">
        <ul class="navbar-nav ml-auto align-items-md-center">
          <li class="nav-item{% if page.permalink == '/' %} active{% endif %}">
            <a
              class="nav-link"
              href="{{ '/' | relative_url }}"
              {% if page.permalink == '/' %}
                aria-current="page"
              {% endif %}
              >Home</a
            >
          </li>
          {% assign sorted_pages = site.pages | sort: 'nav_order' %}
          {% for nav_page in sorted_pages %}
            {% if nav_page.nav and nav_page.autogen == null %}
              {% assign nav_active = false %}
              {% if page.url == nav_page.url %}{% assign nav_active = true %}{% endif %}
              {% if page.dataset_key and nav_page.permalink == '/datasets/' %}{% assign nav_active = true %}{% endif %}
              <li class="nav-item{% if nav_active %} active{% endif %}">
                <a
                  class="nav-link"
                  href="{{ nav_page.url | relative_url }}"
                  {% if nav_active %}
                    aria-current="page"
                  {% endif %}
                >
                  {{- nav_page.nav_title | default: nav_page.title -}}
                </a>
              </li>
            {% endif %}
          {% endfor %}
          {% if site.enable_darkmode %}
            <li class="nav-item theme-toggle-item">
              <button id="light-toggle" class="theme-toggle" type="button" title="Change colour theme" aria-label="Change colour theme">
                <span id="light-toggle-system" aria-hidden="true">◐</span>
                <span id="light-toggle-dark" aria-hidden="true">☾</span>
                <span id="light-toggle-light" aria-hidden="true">☀</span>
              </button>
            </li>
          {% endif %}
        </ul>
      </div>
    </div>
  </nav>
  {% if site.enable_progressbar %}
    <progress id="progress" value="0" aria-label="Page reading progress">
      <span class="progress-bar"></span>
    </progress>
  {% endif %}
</header>
